# Copy to app/backend/.env and fill in to point at the real services.
# With NO .env present, the app runs fully offline: bundled fixtures + in-memory tickets.

# ---- App datastore (SQLite locally; Cloud SQL Postgres in prod) ----
# APP_DB_URL=postgresql+psycopg://user:pass@host:5432/wonder

# ---- Adapters: flip these to go live ----
# DATA_SOURCE=bigquery      # fixtures | bigquery
# TICKET_SINK=jira          # memory   | jira

# ---- BigQuery (read-only) — required when DATA_SOURCE=bigquery ----
# GCP_PROJECT=wonder-data-prod
# BQ_DATASET=inventory
# BQ_LEDGER_TABLE=unified_inventory_ledger
# BQ_PO_TABLE=purchase_order_table
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/readonly-sa-key.json
#   (or run `gcloud auth application-default login` instead of a key file)
#   On hosts with no GCP ADC (e.g. Azure App Service/Functions), set
#   GOOGLE_SERVICE_ACCOUNT_JSON to the SA key's raw JSON instead (e.g. sourced from an
#   Azure Key Vault secret) — takes precedence over GOOGLE_APPLICATION_CREDENTIALS/ADC.
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}'
#   NOTE: also edit wonder/schema_map.py so the column names match the real tables.

# ---- Jira Cloud — required when TICKET_SINK=jira ----
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@wonder.com
# JIRA_API_TOKEN=...                 # https://id.atlassian.com/manage/api-tokens
# JIRA_PROJECT_KEY=WIQ
# JIRA_ISSUE_TYPE=Task
# JIRA_FINGERPRINT_FIELD=            # e.g. customfield_10050 (else a label carries the fingerprint)
# JIRA_DONE_TRANSITION=Done          # transition name used for auto-close

# ---- Tunables ----
# HISTORY_DAYS=21
# RUN_DATE=2026-06-09                # latest partition to validate (default: today)
# OVER_RECEIPT_HIGH_PCT=0.05         # PO over-receipt -> High
# OVER_RECEIPT_URGENT_PCT=0.10       # PO over-receipt -> Urgent
